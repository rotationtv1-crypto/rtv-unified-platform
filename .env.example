# RotationTV Unified Platform — Environment Template
# Copy to .env.local for development. Never commit real values.

# Frontend
VITE_APP_NAME=RotationTV
VITE_APP_URL=http://localhost:5173

# Platform API (rtv-api Worker). Production:
# VITE_API_URL=https://rtv-api.rotationtimmy.workers.dev/api
VITE_API_URL=http://localhost:8787/api

# Live ingest/playback gateway (rtv-ai-gateway Worker). ECS is LiveKit/media only.
VITE_STREAM_GATEWAY_URL=https://rtv-ai-gateway.rotationtvaicom.workers.dev

# Optional Cloudflare Stream live-input uid used by the hero player.
VITE_DEFAULT_STREAM_UID=

# API / Supabase (get from your Supabase project settings)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Telegram (get from @BotFather)
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
VITE_TELEGRAM_BOT_NAME=Your Bot Name
VITE_TELEGRAM_MINI_APP_URL=https://t.me/YourBotUsername/app

# Server-side secrets — never expose these as VITE_* variables.
# Configure TRIBUTE_API_KEY in the Supabase Edge Function secret store.
TRIBUTE_API_KEY=

# Feature Flags
VITE_ENABLE_TELEGRAM_PAYMENTS=true
VITE_ENABLE_TON_PAYMENTS=false
VITE_ENABLE_SUBSCRIPTIONS=true
